{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "sched 디버깅 (Windows)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/bin/sched.exe",
      "args": ["--version"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "build (debug)"
    },
    {
      "name": "테스트 디버깅 (Windows)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/bin/sched_tests.exe",
      "args": ["--success"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "build (debug)"
    },
    {
      "name": "테스트 디버깅 (리눅스 · 코어만)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug-core-only/bin/sched_tests",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "preLaunchTask": "build (코어만 · 리눅스)"
    }
  ]
}
